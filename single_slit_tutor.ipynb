    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "# 支持从项目目录或其上一级目录启动 Notebook。\n",
    "project = Path.cwd()\n",
    "if not (project / \"app.py\").exists():\n",
    "    project = project / \"single_slit_tutor\"\n",
    "sys.path.insert(0, str(project.resolve()))\n",
    "\n",
    "import app\n",
    "app.launch()\n"
   ]
